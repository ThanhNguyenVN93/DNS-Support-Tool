<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DNS Flush and Renew (Release)</AssemblyName>
    <ApplicationIcon>bin\Debug\net8.0-windows\dns.ico</ApplicationIcon>
    <Title>DNS Flush and Renew (Release)</Title>
    <Company>ThanhCode93</Company>
    <Description>Making it easier for users to change DNS and perform renew/release</Description>
    <!-- Single EXE: requires .NET 8 runtime on target machine -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="bin\Debug\net8.0-windows\dns.ico" />
    <EmbeddedResource Include="Resources\images.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude 4.7.2 subfolder from this project -->
    <Compile Remove="4.7.2\**" />
    <EmbeddedResource Remove="4.7.2\**" />
    <None Remove="4.7.2\**" />
    <Content Remove="4.7.2\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="4.7.2\FormNetInstaller.cs" />
    <Compile Include="4.7.2\FormNetInstaller.Designer.cs" />
  </ItemGroup>

</Project>