<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net35</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DNS Flush Launcher</AssemblyName>
    <ApplicationIcon>..\4.7.2\dns.ico</ApplicationIcon>
    <LangVersion>3</LangVersion>
    <PlatformTarget>x86</PlatformTarget>
    <Title>DNS Flush Launcher</Title>
    <Company>ThanhCode93</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundle offline .NET 4.6.2 installer alongside the launcher -->
    <Content Include="ndp462-kb3151800-x86-x64-allos-enu.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
